# -----------------------------------------------------------------------------
# KnowledgeHub AI - Environment Configuration Example
# -----------------------------------------------------------------------------

# Server Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (PostgreSQL + pgvector)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=knowledgehub
DB_USER=postgres
DB_PASSWORD=your_secure_postgres_password

# Authentication (JWT)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970337336763979244226452948404D6351
JWT_EXPIRATION_MS=86400000

# Local AI Engine (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_MOCK_FALLBACK=true

# Storage Directories
KNOWLEDGEHUB_UPLOAD_DIR=./data/uploads
KNOWLEDGEHUB_OKF_DIR=./data/okf
